        "---\n",
        "title: \"This Means (Bayesian) War(fare)!\"\n",
        "subtitle: \"A Bayesian Neural Network Approach to Electronic Warfare\"\n",
        "author: \"Maggie Morrison and Joshua DiLena (Advisor: Dr. Cohen)\"\n",
        "date: today\n",
